# =============================================================================
# Jewellery ERP Customer Desktop Application - Environment Configuration
# =============================================================================

# Central Licensing Authority Base URL
# Default production endpoint for product key activations, owner onboarding, and credential sync.
# In production, this points to the official HTTPS endpoint.
LICENSE_SERVER_URL=https://api.jewelleryerp.com

# Node Environment: 'production' | 'development'
NODE_ENV=production

# Security: Self-registration is strictly disabled in production.
# Only enable in local development test rigs.
ENABLE_DEV_SELF_REGISTER=false
