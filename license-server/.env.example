# =============================================================================
# Jewellery ERP Central Licensing & Super Admin Server - Production Environment
# =============================================================================

# Server Port
PORT=5000

# Environment Mode: 'production' | 'development' | 'test'
NODE_ENV=production

# Trust Proxy: Enable if deployed behind Nginx, Cloudflare, AWS ALB, Render
TRUST_PROXY=true

# MongoDB Production Connection String
# Example: mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/jewellery_erp_licensing?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@<DB_CLUSTER_HOST>/jewellery_erp_licensing?retryWrites=true&w=majority

# Production Session Secret (Must be unique, cryptographically random, >= 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_cryptographically_random_secret_at_least_32_characters_long

# Allowed CORS Origins for Super Admin Web Portal (comma-separated for multiple origins)
# Example: https://admin.jewelleryerp.com,https://owner.jewelleryerp.com
CORS_ORIGINS=https://admin.jewelleryerp.com

# Ed25519 Private Signing Key (PEM format)
# Note: Keep this private key strictly on this server! NEVER distribute to desktop clients or repositories.
# Generate with: openssl genpkey -algorithm ed25519 -out private_key.pem
ED25519_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_PRODUCTION_ED25519_PRIVATE_KEY_PEM\n-----END PRIVATE KEY-----"
